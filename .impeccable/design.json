  "narrative": {
    "northStar": "El Pizarrón del Mostrador",
    "overview": "Interfaz oscura de cocina nocturna: café carbón como lienzo, crema como tinta, y dos acentos de salsa, rojo chile para la acción y amarillo para dinero y selección. La tipografía de marcador aparece solo en la marca y en las cifras que cierran una operación.",
    "keyCharacteristics": ["Tema oscuro único, mobile-first (columna de máx. 448px centrada).","Rojo = acción de vender/confirmar; amarillo = dinero, selección, foco.","Marcador solo en marca y totales.","Radios generosos (10 a 28px), sin sombras."],
    "rules": [
      {"name":"The Money Gold Rule","body":"El amarillo señala dinero y selección; no se usa como decoración.","section":"colors"},
      {"name":"The One Red Rule","body":"Una sola acción roja dominante por pantalla.","section":"colors"},
      {"name":"The Marker Is Rare Rule","body":"Marcador solo en marca y cifras finales de dinero.","section":"typography"},
      {"name":"The Tabular Money Rule","body":"Todo importe usa tabular-nums y formato $1,234.","section":"typography"},
      {"name":"The Flat Tonal Rule","body":"Elevar = subir un escalón de superficie, nunca añadir sombra.","section":"elevation"}
    ],
    "dos": ["Do usar chili solo para la acción principal de venta y gold para dinero y selección.","Do mantener objetivos táctiles ≥44px y texto ≥13px.","Do mostrar totales, cambio y faltantes siempre visibles, en tabular-nums.","Do expresar profundidad con escalones de superficie."],
    "donts": ["Don't usar marcador en texto corrido o etiquetas.","Don't añadir sombras ni degradados.","Don't introducir fondos claros: el tema es oscuro único.","Don't cambiar nombre, logo DT ni la combinación oscuro + rojo + amarillo + crema."]
  }
